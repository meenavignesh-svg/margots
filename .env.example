# === Frontend talks to this gateway (server-side secrets only) ===
MARGOTS_ENV=development
MARGOTS_HOST=0.0.0.0
MARGOTS_PORT=8080
MARGOTS_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://meenavignesh-svg.github.io
MARGOTS_REQUEST_TIMEOUT=20
MARGOTS_MAX_QUERY_CHARS=4000
MARGOTS_RATE_LIMIT_PER_MINUTE=60

# Server-side LLM providers (never put these in docs/ JavaScript)
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
XAI_API_KEY=
XAI_MODEL=
