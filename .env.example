# Server
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
MAX_REQUEST_BYTES=10485760
LOG_LEVEL=INFO
REQUIRE_AI=1

# CORS — replace with exact trusted frontend origins in production
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080

# Rate limiting — use shared Redis storage when running multiple backend instances
RATE_LIMIT_DEFAULT=120 per minute
ANALYZE_RATE_LIMIT=30 per minute
SEARCH_RATE_LIMIT=20 per minute
RATELIMIT_STORAGE_URI=memory://

# Online Ollama Cloud — keep this secret server-side; never put it in frontend code.
OLLAMA_API_KEY=
OLLAMA_CLOUD_URL=https://ollama.com
OLLAMA_CLOUD_MODEL=gpt-oss:20b

# Local Ollama fallback — no API key required.
OLLAMA_ENABLED=1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
LLM_TIMEOUT_SECONDS=90

# Optional cloud fallbacks
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-reasoning
