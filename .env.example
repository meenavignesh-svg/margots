# Server
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MAX_REQUEST_BYTES=10485760
LLM_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO

# Optional server-side AI providers. Never put these in frontend files.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
XAI_API_KEY=
XAI_MODEL=

# Optional Google Custom Search for a server-side search gateway.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
