# Server
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
MAX_REQUEST_BYTES=10485760
LOG_LEVEL=INFO

# CORS — must include the GitHub Pages origin in production
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500,https://meenavignesh-svg.github.io

# Optional server-side AI providers. Never put these in frontend files.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
XAI_API_KEY=
XAI_MODEL=

# Optional Google Custom Search for /api/search
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
